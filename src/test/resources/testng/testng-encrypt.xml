<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="JGroups Encrypt Tests" verbose="0"
       parallel="classes" thread-count="10"
       time-out="1800000"
       configfailurepolicy="continue"
       usedefaultlisteners="false">

    <test name="Encrypt">
        <groups>
            <run>
                <include name="encrypt"/>
                <exclude name="broken"/>
            </run>
        </groups>
        <packages>
            <!-- Recursive catch-all: org.jgroups.* including future sub-packages -->
            <package name="org.jgroups.*"/>
        </packages>
    </test>

    <listeners>
        <listener class-name="org.jgroups.util.JUnitXMLReporter"/>
    </listeners>
</suite>
